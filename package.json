{
  "name": "trs-restoration-api",
  "version": "1.0.0",
  "description": "REST API for TRS restoration estimating: jobs, status workflow, cost estimates and AI-ready damage assessments",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "start:dev": "ts-node-dev --respawn -r tsconfig-paths/register src/index.ts",
    "dev": "npm run start:dev",
    "typeorm": "typeorm-ts-node-commonjs",
    "migrate": "npm run db-migrate:run",
    "db-migrate:generate": "npx ts-node --project tsconfig.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate ./src/database/migrations/MyNewMigration -d src/config/data-source.ts",
    "db-migrate:run": "npx ts-node --project tsconfig.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run --dataSource src/config/data-source.ts",
    "db-migrate:revert": "npx ts-node --project tsconfig.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert --dataSource src/config/data-source.ts",
    "db-migrate:run:prod": "npx typeorm migration:run --dataSource dist/config/data-source.js",
    "seed": "ts-node --project tsconfig.json -r tsconfig-paths/register src/database/seeders/seed-runner.ts",
    "seed:prod": "node dist/database/seeders/seed-runner.js",
    "keys:generate": "node scripts/generate-keys.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:int": "jest -c jest.integration.config.cjs",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,md}'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "@faker-js/faker": "^9.9.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/swagger-ui-express": "^4.1.8",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.8",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.31",
    "typescript": "^5.9.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint": "^8.72.0"
  }
}
