# ===== Application ===== #
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
SERVICE_NAME=trs-restoration-api
SERVICE_VERSION=1.0.0

# ===== Database (PostgreSQL) ===== #
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trs_restoration
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false
TEST_DB_NAME=trs_restoration_test

# ===== Redis ===== #
# memory = in-process Redis Use redis in production.
REDIS_DRIVER=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=trs
REDIS_TTL=3600

# ===== JWT (RS256) ===== #
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ===== Rate limiting ===== #
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_MULTIPLIER=1

# ===== CORS ===== #
ALLOWED_ORIGINS=http://localhost:3000

# ===== Logging ===== #
LOG_LEVEL=info
ENABLE_FILE_LOGGING=false

# ===== AI (optional) ===== #
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_MS=120000

# ===== Seeding ===== #
SEED_USER_PASSWORD=Password123!
